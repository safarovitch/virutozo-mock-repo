{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@nimbus/mf-contract": [
        "./libs/mf-contract/src/index.ts"
      ],
      "@nimbus/design-tokens": [
        "./libs/design-tokens/src/index.ts"
      ],
      "@nimbus/logger": [
        "./libs/logger/src/index.ts"
      ],
      "@nimbus/format": [
        "./libs/format/src/index.ts"
      ],
      "@nimbus/messages": [
        "./libs/messages/src/index.ts"
      ]
    }
  }
}
