{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@nimbus/mf-contract": [
        "./libs/mf-contract/src/index.ts"
      ],
      "@nimbus/design-tokens": [
        "./libs/design-tokens/src/index.ts"
      ],
      "@nimbus/logger": [
        "./libs/logger/src/index.ts"
      ],
      "@nimbus/format": [
        "./libs/format/src/index.ts"
      ],
      "@nimbus/messages": [
        "./libs/messages/src/index.ts"
      ],
      "@nimbus/api-client": [
        "./libs/api-client/src/index.ts"
      ],
      "@nimbus/api-client/*": [
        "./libs/api-client/src/*.ts"
      ],
      "@nimbus/api-client/model": [
        "./libs/api-client/src/generated/model/index.ts"
      ],
      "@nimbus/realtime": [
        "./libs/realtime/src/index.ts"
      ],
      "@nimbus/test-utils": [
        "./libs/test-utils/src/index.ts"
      ],
      "@nimbus/auth": [
        "./libs/auth/src/index.ts"
      ],
      "@nimbus/auth/*": [
        "./libs/auth/src/*"
      ]
    }
  }
}
