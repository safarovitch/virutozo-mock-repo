# Local overrides. Copy to `.env` (git-ignored); values already set in your shell win.
# Read by tools/gateway-port.mjs for `pnpm e2e`, `pnpm e2e:stack` and `pnpm demo:local`.

# Gateway port (default 8080). Playwright's baseURL and mock-api's APP_ORIGINS follow it.
# 8090 for machines where something else (e.g. macOS Apache) holds 8080.
GATEWAY_PORT=8090
