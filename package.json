{
  "name": "nimbus-console",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p shell tenants storage compute mock-api --parallel=5",
    "build": "nx run-many -t build",
    "build:e2e": "nx run-many -t build-e2e",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:hooks": "node --test '.claude/hooks/__tests__/*.test.mjs'",
    "trace": "node tools/check-trace.ts",
    "perf": "playwright test --config apps/e2e/playwright.perf.config.ts",
    "e2e:stack": "pnpm build:e2e && node tools/run-stack.mjs e2e",
    "e2e": "playwright test --config apps/e2e/playwright.config.ts",
    "demo:local": "pnpm build:e2e && node tools/run-stack.mjs demo-local",
    "format": "prettier --write .",
    "prepare": "lefthook install",
    "check:no-test-hooks": "nx run-many -t build -p shell tenants storage compute && node tools/ci/no-test-hooks.mjs",
    "contract:build": "nx run contracts:contract-build",
    "api:generate": "nx run api-client:generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.23.7",
    "@nx/js": "24.0.2",
    "@nx/vite": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "nx": "24.0.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
